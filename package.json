{
  "name": "reeve",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first personal budgeting on a double-entry ledger, with envelope budgeting.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @reeve/web --filter @reeve/desktop dev",
    "dev:landing": "pnpm --filter @reeve/landing dev",
    "dev:web": "pnpm --parallel --filter @reeve/server --filter @reeve/web dev",
    "build": "pnpm --filter @reeve/web build && pnpm --filter @reeve/desktop build",
    "package": "pnpm build && pnpm --filter @reeve/desktop package",
    "lint": "oxlint --deny-warnings apps packages scripts",
    "lint:fix": "oxlint --fix --deny-warnings apps packages scripts",
    "react-doctor": "react-doctor --yes --no-score --no-supply-chain --no-cache --blocking warning",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/landing/tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict --severity error,warning",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:properties": "REEVE_PROPERTY_RUNS=${REEVE_PROPERTY_RUNS:-2000} REEVE_PROPERTY_SEED=${REEVE_PROPERTY_SEED:-random} REEVE_PROPERTY_REPORT=1 vitest run packages/engine/test/properties",
    "benchmark:properties": "node scripts/property-benchmark.ts",
    "test:mutation": "stryker run",
    "test:e2e": "vitest run --config packages/e2e/vitest.config.ts",
    "check": "pnpm check:push && pnpm test:e2e && pnpm check:desktop",
    "check:push": "pnpm format:check && pnpm lint && pnpm run react-doctor && pnpm typecheck && pnpm check:rules && pnpm test",
    "check:rules": "node scripts/check-rules.ts",
    "check:desktop": "node scripts/check-desktop.ts",
    "prepare": "lefthook install",
    "reeve": "node packages/cli/src/main.ts",
    "brand:generate": "node scripts/generate-brand.ts",
    "db:generate": "drizzle-kit generate --config packages/engine/drizzle.config.ts && node scripts/bundle-migrations.ts",
    "catalog:generate": "node scripts/routes.ts && node packages/cli/src/main.ts skills export && oxfmt packages/contract/src/routes.gen.ts .agents/skills/reeve/SKILL.md"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/tsgo": "0.67.5",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "effect": "4.0.6",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "oxc-parser": "0.148.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-core": "1.64.1",
    "react-doctor": "0.9.18",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "packageManager": "pnpm@12.9.1"
}
